export struct LibraryItem {
    id: string,
    name: string,
    selected: bool,
}

export struct AlbumItem {
    id: string,
    title: string,
    artist: string,
    artist_id: string,
    year: string,
    genre: string,
    song_count: int,
    duration_text: string,
    starred: bool,
    cover: image,
    has_cover: bool,
}

export struct ArtistItem {
    id: string,
    name: string,
    album_count: int,
    starred: bool,
}

export struct SongItem {
    id: string,
    track_num: string,
    title: string,
    artist: string,
    artist_id: string,
    album: string,
    album_id: string,
    duration_text: string,
    duration_secs: int,
    quality_badge: string,
    starred: bool,
    rating: int,
    is_downloaded: bool,
    is_playing: bool,
    play_count: int,
    disc_number: int,
}

export struct PlaylistItem {
    id: string,
    name: string,
    comment: string,
    owner: string,
    public: bool,
    song_count: int,
    duration_text: string,
}

export struct GenreItem {
    name: string,
    song_count: int,
    album_count: int,
}

export struct LyricLineItem {
    time_ms: int,
    text: string,
    active: bool,
}

export struct ShareItem {
    id: string,
    url: string,
    description: string,
    visit_count: int,
}

export struct ThemeItem {
    id: string,
    name: string,
    accent: string,
    bg_canvas: string,
    is_custom: bool,
}
