import { ScrollView } from "std-widgets.slint";
import {
    LibraryItem,
    AlbumItem,
    ArtistItem,
    SongItem,
    PlaylistItem,
    GenreItem,
    LyricLineItem,
    ShareItem
} from "models.slint";
export {
    LibraryItem,
    AlbumItem,
    ArtistItem,
    SongItem,
    PlaylistItem,
    GenreItem,
    LyricLineItem,
    ShareItem
}
import { Theme, Icons, Hairline, VectorIcon } from "theme.slint";
import {
    StyledTextInput,
    TrackSlider,
    PillButton,
    IconButton,
    SidebarNavRow,
    AlbumTile,
    TrackTableHeader,
    TrackRow
} from "components.slint";
import {
    SkeletonBlock,
    TrackRowSkeleton,
    AlbumTileSkeleton,
    AlbumRowSkeleton,
    TrackTableSkeleton,
    AlbumDetailSkeleton,
    ArtistDetailSkeleton
} from "skeletons.slint";

export component AppWindow inherits Window {
    title: "Ultrasonic — Navidrome Music";
    min-width: 380px;
    min-height: 580px;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.bg-canvas;

    // Loading & pulse states
    in-out property <bool> is-loading: false;
    in-out property <bool> pulse-phase: false;

    // Responsive layout properties (Aspect-ratio auto detection + Settings override)
    in-out property <string> layout-override: "auto"; // "auto", "mobile", "desktop"
    out property <bool> is-mobile: root.layout-override == "mobile" || (root.layout-override != "desktop" && (root.width < 768px || root.width < root.height));
    in-out property <bool> offline-mode-active: false;

    // Customizable Navigation Tabs Visibility
    in-out property <bool> nav-show-listen-now: true;
    in-out property <bool> nav-show-albums: true;
    in-out property <bool> nav-show-artists: true;
    in-out property <bool> nav-show-songs: true;
    in-out property <bool> nav-show-playlists: true;
    in-out property <bool> nav-show-genres: true;
    in-out property <bool> nav-show-favorites: true;
    in-out property <bool> nav-show-search: true;

    // Library downloaded-only filter
    in-out property <bool> filter-downloaded-only: false;

    // Expanded Player & Desktop Panel
    in-out property <bool> expanded-player-open: false;
    in-out property <bool> desktop-panel-open: false;
    in-out property <string> expanded-player-tab: "cover"; // "cover", "lyrics", "queue"

    // Navigation & View state
    in-out property <string> active-view: "listen_now";
    in-out property <string> album-sort-type: "newest";
    in-out property <string> search-query: "";
    in-out property <string> status-message: "";
    in-out property <bool> is-connected: false;
    in-out property <string> server-version-badge: "Navidrome / OpenSubsonic";
    in-out property <string> active-libraries-summary: "All Libraries";

    // Right drawer state ("none", "lyrics", "queue")
    in-out property <string> right-drawer: "none";

    // Server & Audio Config properties
    in-out property <string> config-server-url: "http://localhost:4533";
    in-out property <string> config-username: "";
    in-out property <string> config-password: "";
    in-out property <string> config-stream-format: "raw";
    in-out property <int> config-stream-bitrate: 0;
    in-out property <string> config-download-format: "raw";
    in-out property <int> config-download-bitrate: 0;
    in-out property <bool> config-auto-download-streamed: true;
    in-out property <bool> config-scrobble-enabled: true;
    in-out property <bool> config-webui-enabled: true;
    in-out property <int> config-webui-port: 4534;

    // Scan status
    in-out property <bool> scan-in-progress: false;
    in-out property <int> scan-count: 0;
    in-out property <string> scan-last-time: "Never";

    // Models
    in-out property <[LibraryItem]> libraries: [];
    in-out property <[AlbumItem]> featured-albums: [];
    in-out property <[AlbumItem]> albums: [];
    in-out property <[ArtistItem]> artists: [];
    in-out property <[AlbumItem]> selected-artist-albums: [];
    in-out property <[SongItem]> selected-artist-top-songs: [];
    in-out property <[SongItem]> songs: [];
    in-out property <[GenreItem]> genres: [];
    in-out property <[PlaylistItem]> playlists: [];
    in-out property <[SongItem]> playlist-songs: [];
    in-out property <[SongItem]> downloaded-songs: [];
    in-out property <[SongItem]> queue-songs: [];
    in-out property <[LyricLineItem]> lyrics-lines: [];
    in-out property <[ShareItem]> shares: [];

    // Selected detail headers
    in-out property <AlbumItem> current-album-detail;
    in-out property <[SongItem]> current-album-songs: [];
    in-out property <string> current-album-notes: "";

    in-out property <string> selected-artist-id: "";
    in-out property <string> selected-artist-name: "";
    in-out property <string> selected-artist-bio: "";

    in-out property <string> selected-genre-name: "";

    in-out property <string> selected-playlist-id: "";
    in-out property <string> selected-playlist-name: "";
    in-out property <string> selected-playlist-comment: "";
    in-out property <int> selected-playlist-count: 0;
    in-out property <string> selected-playlist-duration: "0:00";
    in-out property <string> new-playlist-name: "";

    // Downloads / Offline storage summary
    in-out property <string> downloads-summary-text: "0 tracks stored locally (0.0 MB)";

    // Playback state
    in-out property <bool> is-playing: false;
    in-out property <bool> shuffle-enabled: false;
    in-out property <string> repeat-mode: "off";
    in-out property <string> now-playing-id: "";
    in-out property <string> now-playing-title: "Not Playing";
    in-out property <string> now-playing-artist: "";
    in-out property <string> now-playing-album: "";
    in-out property <string> now-playing-album-id: "";
    in-out property <string> now-playing-artist-id: "";
    in-out property <string> now-playing-quality: "READY";
    in-out property <bool> now-playing-starred: false;
    in-out property <bool> now-playing-is-local: false;
    in-out property <int> now-playing-rating: 0;
    in-out property <image> now-playing-cover;
    in-out property <bool> now-playing-has-cover: false;
    in-out property <float> playback-progress: 0.0;
    in-out property <string> playback-current-time: "0:00";
    in-out property <string> playback-total-time: "0:00";
    in-out property <float> volume: 0.85;

    // Callbacks
    callback navigate(string);
    callback toggle-library(string);
    callback select-all-libraries();
    callback change-album-sort(string);
    callback run-search(string);
    callback open-album(string);
    callback play-album(string);
    callback download-album(string);
    callback open-artist(string);
    callback select-genre(string);
    callback select-playlist(string);
    callback create-new-playlist(string);
    callback delete-selected-playlist();
    callback download-selected-playlist();
    callback add-current-song-to-playlist(string);
    callback remove-song-from-selected-playlist(int);
    callback share-current-album();
    callback delete-share(string);

    callback play-song(string);
    callback queue-song(string);
    callback download-song(string);
    callback toggle-star(string, bool);
    callback toggle-album-star(string, bool);
    callback set-song-rating(string, int);

    callback transport-play-pause();
    callback transport-next();
    callback transport-prev();
    callback transport-seek(float);
    callback transport-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();

    callback save-queue-to-server();
    callback load-queue-from-server();
    callback clear-queue();
    callback clear-downloads();

    callback save-and-connect();
    callback disconnect-server();
    callback set-stream-format(string);
    callback set-stream-bitrate(int);
    callback set-download-format(string);
    callback set-download-bitrate(int);
    callback toggle-auto-download-streamed(bool);
    callback trigger-server-scan(bool);
    callback set-layout-override(string);
    callback toggle-nav-section(string, bool);
    callback clear-local-storage();

    // =========================================================================
    // STARTUP LOGIN SCREEN (Shown whenever not connected and not in offline mode)
    // =========================================================================
    if !root.is-connected && !root.offline-mode-active : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-canvas;

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 400px;
                    border-radius: 12px;
                    background: Theme.bg-sidebar;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 32px;
                        spacing: 18px;

                        // App Emblem & Title
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 10px;
                                background: Theme.accent;

                                VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.note;
                                    icon-size: 24px;
                                    icon-color: #ffffff;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "Sign in to Navidrome";
                                    color: Theme.text-primary;
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Ultrasonic OpenSubsonic Music Player";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }
                            }
                        }

                        Hairline {}

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "SERVER URL";
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            StyledTextInput {
                                text <=> root.config-server-url;
                                placeholder: "http://localhost:4533 or https://music.example.com";
                                accepted => { root.save-and-connect(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "USERNAME";
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            StyledTextInput {
                                text <=> root.config-username;
                                placeholder: "Navidrome username";
                                accepted => { root.save-and-connect(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "PASSWORD";
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            StyledTextInput {
                                text <=> root.config-password;
                                input-type: InputType.password;
                                placeholder: "Password (authenticated via MD5 token + salt)";
                                accepted => { root.save-and-connect(); }
                            }
                        }

                        if root.status-message != "" : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: root.status-message;
                                    color: Theme.text-primary;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // Primary Sign In Button
                        Rectangle {
                            height: 38px;
                            border-radius: 7px;
                            background: login-touch.has-hover ? Theme.accent-hover : Theme.accent;

                            Text {
                                text: "Connect to Navidrome";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            login-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.save-and-connect(); }
                            }
                        }

                        // Secondary Offline Mode Button
                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: offline-touch.has-hover ? Theme.bg-hover : transparent;

                            Text {
                                text: "Open Downloaded Music Offline (" + root.downloads-summary-text + ")";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            offline-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.offline-mode-active = true;
                                    root.navigate("downloads");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // MAIN APPLICATION WORKSPACE (Shown once authenticated or in offline mode)
    // =========================================================================
    if root.is-connected || root.offline-mode-active : VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // -----------------------------------------------------------------
            // LEFT SIDEBAR (Desktop Mode)
            // -----------------------------------------------------------------
            if !root.is-mobile : Rectangle {
                width: 240px;
                background: Theme.bg-sidebar;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding: 14px;
                        spacing: 12px;

                        // App Header
                        HorizontalLayout {
                            height: 28px;
                            spacing: 9px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: Theme.accent;
                                    VectorIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.note;
                                        icon-size: 14px;
                                        icon-color: #ffffff;
                                    }
                                }
                            }

                            Text {
                                text: "Music";
                                color: Theme.text-primary;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.is-connected ? Theme.green-badge : Theme.accent;
                                }
                            }
                        }

                        // Search Field
                        StyledTextInput {
                            height: 30px;
                            text <=> root.search-query;
                            placeholder: "Search Library...";
                            accepted(val) => {
                                root.active-view = "search";
                                root.run-search(val);
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 16px;
                                alignment: start;

                                // NAVIDROME MULTI-LIBRARY FILTER SECTION
                                if root.libraries.length > 0 : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 18px;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "LIBRARIES";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 28px;
                                            Text {
                                                text: "All";
                                                color: Theme.accent;
                                                font-size: 10px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select-all-libraries(); }
                                            }
                                        }
                                    }

                                    for lib in root.libraries : Rectangle {
                                        height: 30px;
                                        border-radius: 6px;
                                        background: lib-touch.has-hover ? Theme.bg-hover : transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 9px;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 15px;
                                                    height: 15px;
                                                    border-radius: 4px;
                                                    background: lib.selected ? Theme.accent : Theme.bg-elevated;
                                                    border-width: 1px;
                                                    border-color: lib.selected ? Theme.accent : Theme.border-subtle;

                                                    if lib.selected : VectorIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        commands: Icons.check;
                                                        icon-size: 11px;
                                                        icon-color: #ffffff;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: lib.name;
                                                color: lib.selected ? Theme.text-primary : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: lib.selected ? 500 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        lib-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-library(lib.id); }
                                        }
                                    }
                                }

                                // LIBRARY NAVIGATION
                                VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        height: 18px;
                                        padding-left: 6px;
                                        Text {
                                            text: "LIBRARY";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.nav-show-listen-now : SidebarNavRow {
                                        icon-path: Icons.listen-now;
                                        label: "Listen Now";
                                        selected: root.active-view == "listen_now";
                                        clicked => { root.navigate("listen_now"); }
                                    }
                                    if root.nav-show-albums : SidebarNavRow {
                                        icon-path: Icons.album;
                                        label: "Albums";
                                        selected: root.active-view == "albums" || root.active-view == "album_detail";
                                        clicked => { root.navigate("albums"); }
                                    }
                                    if root.nav-show-artists : SidebarNavRow {
                                        icon-path: Icons.artist;
                                        label: "Artists";
                                        selected: root.active-view == "artists";
                                        clicked => { root.navigate("artists"); }
                                    }
                                    if root.nav-show-songs : SidebarNavRow {
                                        icon-path: Icons.note;
                                        label: "Songs";
                                        selected: root.active-view == "songs";
                                        clicked => { root.navigate("songs"); }
                                    }
                                    if root.nav-show-genres : SidebarNavRow {
                                        icon-path: Icons.grid;
                                        label: "Genres";
                                        selected: root.active-view == "genres";
                                        clicked => { root.navigate("genres"); }
                                    }
                                    if root.nav-show-favorites : SidebarNavRow {
                                        icon-path: Icons.heart-fill;
                                        label: "Favorites";
                                        selected: root.active-view == "favorites";
                                        clicked => { root.navigate("favorites"); }
                                    }
                                    if root.nav-show-search : SidebarNavRow {
                                        icon-path: Icons.search;
                                        label: "Search";
                                        selected: root.active-view == "search";
                                        clicked => { root.navigate("search"); }
                                    }
                                }

                                // PLAYLISTS SECTION
                                if root.nav-show-playlists : VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        height: 18px;
                                        padding-left: 6px;
                                        Text {
                                            text: "PLAYLISTS";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    SidebarNavRow {
                                        icon-path: Icons.list;
                                        label: "All Playlists";
                                        selected: root.active-view == "playlists" && root.selected-playlist-id == "";
                                        clicked => { root.navigate("playlists"); }
                                    }

                                    for pl in root.playlists : SidebarNavRow {
                                        icon-path: Icons.list;
                                        label: pl.name;
                                        badge: pl.song_count;
                                        selected: root.active-view == "playlists" && root.selected-playlist-id == pl.id;
                                        clicked => {
                                            root.active-view = "playlists";
                                            root.select-playlist(pl.id);
                                        }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        SidebarNavRow {
                            icon-path: Icons.settings;
                            label: "Server & Audio";
                            badge: root.config-stream-format == "raw" ? "RAW" : root.config-stream-format;
                            selected: root.active-view == "settings";
                            clicked => { root.navigate("settings"); }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border-subtle;
                    }
                }
            }

            // -----------------------------------------------------------------
            // CENTER VIEWPORT
            // -----------------------------------------------------------------
            VerticalLayout {
                horizontal-stretch: 1;

                // Top Header Bar
                Rectangle {
                    height: 48px;
                    background: Theme.bg-canvas;

                    VerticalLayout {
                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;

                            Text {
                                text: root.active-view == "listen_now" ? "Listen Now"
                                    : root.active-view == "albums" ? "Albums"
                                    : root.active-view == "album_detail" ? root.current-album-detail.title
                                    : root.active-view == "artists" ? "Artists"
                                    : root.active-view == "songs" ? "Songs"
                                    : root.active-view == "genres" ? "Genres"
                                    : root.active-view == "favorites" ? "Favorites"
                                    : root.active-view == "downloads" ? "Downloaded Music"
                                    : root.active-view == "playlists" ? "Playlists"
                                    : root.active-view == "search" ? "Search Results"
                                    : "Server & Audio Settings";
                                color: Theme.text-primary;
                                font-size: 18px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 22px;
                                    width: lib-sum-txt.preferred-width + 18px;
                                    border-radius: 11px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    lib-sum-txt := Text {
                                        text: root.active-libraries-summary;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.navigate("settings"); }
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if !root.is-mobile && root.status-message != "" : Text {
                                text: root.status-message;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Hairline {}
                    }
                }

                // =============================================================
                // VIEW 1: LISTEN NOW
                // =============================================================
                if root.active-view == "listen_now" && root.is-loading : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 20px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: "Recently Added Albums";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                for _ in [0, 1, 2, 3, 4] : AlbumTileSkeleton {
                                    pulse: root.pulse-phase;
                                }
                            }
                        }

                        Hairline {}

                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: "Songs from Selected Libraries";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }

                            TrackTableSkeleton {
                                pulse: root.pulse-phase;
                                compact: root.is-mobile;
                            }
                        }
                    }
                }

                if root.active-view == "listen_now" && !root.is-loading : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 20px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: "Recently Added Albums";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: "All Albums";
                                        clicked => { root.navigate("albums"); }
                                    }
                                }
                            }

                            ScrollView {
                                height: 214px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    for alb in root.featured-albums : AlbumTile {
                                        album: alb;
                                        open-album(id) => { root.open-album(id); }
                                        play-album(id) => { root.play-album(id); }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: "Songs from Selected Libraries";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: "Refresh Mix";
                                        clicked => { root.navigate("listen_now"); }
                                    }
                                }
                            }

                            TrackTableHeader {
                                compact: root.is-mobile;
                            }

                            for s[idx] in root.songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 2: ALBUMS BROWSER
                // =============================================================
                if root.active-view == "albums" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 44px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 6px;
                            alignment: start;

                            for filter in [
                                { id: "newest", title: "Newest" },
                                { id: "recent", title: "Recently Played" },
                                { id: "frequent", title: "Most Played" },
                                { id: "starred", title: "Favorites" },
                                { id: "alphabeticalByName", title: "A–Z Title" },
                                { id: "alphabeticalByArtist", title: "A–Z Artist" },
                                { id: "random", title: "Random" },
                            ] : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    label: filter.title;
                                    active: root.album-sort-type == filter.id;
                                    clicked => { root.change-album-sort(filter.id); }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            alignment: start;

                            for idx in [0, 1, 2, 3, 4, 5, 6, 7] : AlbumRowSkeleton {
                                pulse: root.pulse-phase;
                                row-index: idx;
                            }
                        }
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            alignment: start;

                            for alb[idx] in root.albums : Rectangle {
                                height: 64px;
                                border-radius: 6px;
                                background: alb-row-touch.has-hover ? Theme.bg-hover : (Math.mod(idx, 2) == 1 ? Theme.bg-row-alt : transparent);

                                alb-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-album(alb.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 14px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 46px;
                                            height: 46px;
                                            border-radius: 5px;
                                            background: Theme.bg-elevated;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;

                                            if alb.has_cover : Image {
                                                width: 100%;
                                                height: 100%;
                                                source: alb.cover;
                                                image-fit: cover;
                                            }
                                            if !alb.has_cover : VectorIcon {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                commands: Icons.album;
                                                icon-size: 20px;
                                                icon-color: Theme.text-muted;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: alb.title;
                                            color: Theme.text-primary;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: alb.artist;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }

                                    if !root.is-mobile : Text {
                                        width: 110px;
                                        text: alb.genre;
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        width: 50px;
                                        text: alb.year;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 80px;
                                        text: alb.song_count + " songs";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            PillButton {
                                                icon-path: Icons.play;
                                                label: "Play";
                                                primary: true;
                                                clicked => { root.play-album(alb.id); }
                                            }
                                            IconButton {
                                                btn-size: 28px;
                                                icon-size: 14px;
                                                icon-path: Icons.download;
                                                clicked => { root.download-album(alb.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 3: ALBUM DETAIL
                // =============================================================
                if root.active-view == "album_detail" && root.is-loading : ScrollView {
                    vertical-stretch: 1;
                    AlbumDetailSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }
                }

                if root.active-view == "album_detail" && !root.is-loading : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: root.is-mobile ? 14px : 22px;
                        spacing: 16px;
                        alignment: start;

                        if root.is-mobile : HorizontalLayout {
                            height: 32px;
                            alignment: start;
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: alb-back-btn.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 12px;
                                    spacing: 4px;
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.chevron-left;
                                        icon-size: 16px;
                                        icon-color: Theme.accent;
                                    }
                                    Text {
                                        text: "Albums";
                                        color: Theme.accent;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                alb-back-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.navigate("albums"); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: root.is-mobile ? 14px : 22px;

                            Rectangle {
                                width: root.is-mobile ? 110px : 168px;
                                height: root.is-mobile ? 110px : 168px;
                                border-radius: 8px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                if root.current-album-detail.has_cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.current-album-detail.cover;
                                    image-fit: cover;
                                }
                                if !root.current-album-detail.has_cover : VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.album;
                                    icon-size: 48px;
                                    icon-color: Theme.text-muted;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.current-album-detail.title;
                                    color: Theme.text-primary;
                                    font-size: 24px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.current-album-detail.artist;
                                    color: Theme.accent;
                                    font-size: 16px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: (root.current-album-detail.genre != "" ? root.current-album-detail.genre + " · " : "")
                                        + (root.current-album-detail.year != "" ? root.current-album-detail.year + " · " : "")
                                        + root.current-album-detail.song_count + " songs, " + root.current-album-detail.duration_text;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                if root.current-album-notes != "" : Text {
                                    text: root.current-album-notes;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    spacing: 8px;
                                    alignment: start;

                                    PillButton {
                                        icon-path: Icons.play;
                                        label: "Play Album";
                                        primary: true;
                                        clicked => { root.play-album(root.current-album-detail.id); }
                                    }
                                    PillButton {
                                        icon-path: root.current-album-detail.starred ? Icons.heart-fill : Icons.heart-line;
                                        label: root.current-album-detail.starred ? "Favorited" : "Favorite";
                                        active: root.current-album-detail.starred;
                                        clicked => { root.toggle-album-star(root.current-album-detail.id, !root.current-album-detail.starred); }
                                    }
                                    PillButton {
                                        icon-path: Icons.download;
                                        label: "Download Album";
                                        clicked => { root.download-album(root.current-album-detail.id); }
                                    }
                                    PillButton {
                                        label: "Share";
                                        clicked => { root.share-current-album(); }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        VerticalLayout {
                            TrackTableHeader {
                                show-album-col: false;
                                compact: root.is-mobile;
                            }
                            for s[idx] in root.current-album-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                show-album-col: false;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 4: ARTISTS (Desktop Split View vs Mobile Single-Column)
                // =============================================================
                // Desktop: Master-Detail Split View (Sidebar list + Detail on right)
                if root.active-view == "artists" && !root.is-mobile : HorizontalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        width: 240px;
                        background: Theme.bg-sidebar;

                        HorizontalLayout {
                            ScrollView {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 2px;
                                    alignment: start;

                                    for art in root.artists : Rectangle {
                                        height: 34px;
                                        border-radius: 6px;
                                        background: root.selected-artist-id == art.id ? Theme.accent
                                                  : (art-touch.has-hover ? Theme.bg-hover : transparent);

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            Text {
                                                text: art.name;
                                                color: root.selected-artist-id == art.id ? #ffffff : Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: root.selected-artist-id == art.id ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: art.album_count;
                                                color: root.selected-artist-id == art.id ? #ffffffcc : Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        art-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open-artist(art.id); }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.border-subtle;
                            }
                        }
                    }

                    if root.is-loading : ScrollView {
                        horizontal-stretch: 1;
                        ArtistDetailSkeleton {
                            pulse: root.pulse-phase;
                            compact: false;
                        }
                    }

                    if !root.is-loading : ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: root.selected-artist-name != "" ? root.selected-artist-name : "Select an Artist";
                                color: Theme.text-primary;
                                font-size: 22px;
                                font-weight: 700;
                            }

                            if root.selected-artist-bio != "" : Text {
                                text: root.selected-artist-bio;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Hairline {}

                            Text {
                                text: "Albums";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            ScrollView {
                                height: 214px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    for alb in root.selected-artist-albums : AlbumTile {
                                        album: alb;
                                        open-album(id) => { root.open-album(id); }
                                        play-album(id) => { root.play-album(id); }
                                    }
                                }
                            }

                            Hairline {}

                            Text {
                                text: "Top Songs";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            TrackTableHeader {
                                compact: false;
                            }

                            for s[idx] in root.selected-artist-top-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: false;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // Mobile: Full-width Artists List (Zero sidebar!)
                if root.active-view == "artists" && root.is-mobile && root.selected-artist-id == "" : VerticalLayout {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 12px;
                        spacing: 2px;
                        Text {
                            text: "Artists";
                            color: Theme.text-primary;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.artists.length + " Artists in Library";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                    }

                    Hairline {}

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;

                            for art in root.artists : Rectangle {
                                height: 52px;
                                background: art-m-touch.has-hover ? Theme.bg-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: Theme.bg-elevated;
                                        VectorIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            commands: Icons.artist;
                                            icon-size: 18px;
                                            icon-color: Theme.text-secondary;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: art.name;
                                            color: Theme.text-primary;
                                            font-size: 15px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: art.album_count + (art.album_count == 1 ? " album" : " albums");
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }
                                    }

                                    VectorIcon {
                                        commands: Icons.chevron-right;
                                        icon-size: 16px;
                                        icon-color: Theme.text-muted;
                                    }
                                }

                                art-m-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-artist(art.id); }
                                }

                                Hairline {
                                    y: parent.height - 1px;
                                    x: 64px;
                                    width: parent.width - 64px;
                                }
                            }
                        }
                    }
                }

                // Mobile: Full-width Artist Detail (with Back button)
                if root.active-view == "artists" && root.is-mobile && root.selected-artist-id != "" : VerticalLayout {
                    vertical-stretch: 1;

                    // Mobile Navigation Bar
                    Rectangle {
                        height: 44px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 30px;
                                    border-radius: 15px;
                                    background: m-back.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 12px;
                                        spacing: 4px;
                                        alignment: center;
                                        VectorIcon {
                                            commands: Icons.chevron-left;
                                            icon-size: 16px;
                                            icon-color: Theme.accent;
                                        }
                                        Text {
                                            text: "Artists";
                                            color: Theme.accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    m-back := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-artist-id = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        ArtistDetailSkeleton {
                            pulse: root.pulse-phase;
                            compact: true;
                        }
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: root.selected-artist-name;
                                color: Theme.text-primary;
                                font-size: 24px;
                                font-weight: 700;
                            }

                            if root.selected-artist-bio != "" : Text {
                                text: root.selected-artist-bio;
                                color: Theme.text-secondary;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Hairline {}

                            Text {
                                text: "Albums";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            ScrollView {
                                height: 214px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    for alb in root.selected-artist-albums : AlbumTile {
                                        album: alb;
                                        open-album(id) => { root.open-album(id); }
                                        play-album(id) => { root.play-album(id); }
                                    }
                                }
                            }

                            Hairline {}

                            Text {
                                text: "Top Songs";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            TrackTableHeader {
                                compact: true;
                            }

                            for s[idx] in root.selected-artist-top-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: true;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 5: SONGS / FAVORITES
                // =============================================================
                if root.active-view == "songs" || root.active-view == "favorites" : VerticalLayout {
                    vertical-stretch: 1;

                    // Filter strip: Downloaded Only / All Music
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            PillButton {
                                icon-path: Icons.download;
                                label: root.filter-downloaded-only ? "Downloaded Only (Active)" : "Filter: Downloaded Only";
                                active: root.filter-downloaded-only;
                                clicked => { root.filter-downloaded-only = !root.filter-downloaded-only; }
                            }
                        }
                    }

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        if !root.filter-downloaded-only : VerticalLayout {
                            alignment: start;
                            for s[idx] in root.songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                        if root.filter-downloaded-only : VerticalLayout {
                            alignment: start;
                            for s[idx] in root.downloaded-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 5B: DEDICATED SEARCH VIEW
                // =============================================================
                if root.active-view == "search" : VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: root.is-mobile ? 12px : 20px;
                    padding-right: root.is-mobile ? 12px : 20px;
                    padding-top: 14px;
                    spacing: 12px;

                    // Prominent Search Bar
                    HorizontalLayout {
                        spacing: 8px;
                        StyledTextInput {
                            horizontal-stretch: 1;
                            text <=> root.search-query;
                            placeholder: "Search artists, albums, songs...";
                            accepted(val) => { root.run-search(val); }
                        }
                        PillButton {
                            icon-path: Icons.search;
                            label: "Search";
                            primary: true;
                            clicked => { root.run-search(root.search-query); }
                        }
                        if root.search-query != "" : PillButton {
                            icon-path: Icons.close;
                            label: "Clear";
                            clicked => { root.search-query = ""; }
                        }
                    }

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 18px;
                            alignment: start;

                            // Matching Albums
                            if root.albums.length > 0 && root.search-query != "" : VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Albums (" + root.albums.length + ")";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                ScrollView {
                                    height: 215px;
                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        for alb in root.albums : AlbumTile {
                                            album: alb;
                                            open-album(aid) => { root.open-album(aid); }
                                            play-album(aid) => { root.play-album(aid); }
                                        }
                                    }
                                }
                            }

                            // Matching Songs
                            if root.songs.length > 0 && root.search-query != "" : VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Songs (" + root.songs.length + ")";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                TrackTableHeader { compact: root.is-mobile; }
                                for s[idx] in root.songs : TrackRow {
                                    song: s;
                                    row-index: idx;
                                    compact: root.is-mobile;
                                    play-song(id) => { root.play-song(id); }
                                    queue-song(id) => { root.queue-song(id); }
                                    toggle-star(id, st) => { root.toggle-star(id, st); }
                                    download-song(id) => { root.download-song(id); }
                                    open-artist(aid) => { root.open-artist(aid); }
                                    open-album(alid) => { root.open-album(alid); }
                                }
                            }

                            // Empty / Placeholder state
                            if root.songs.length == 0 && root.albums.length == 0 : VerticalLayout {
                                padding-top: 40px;
                                spacing: 12px;
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.search;
                                        icon-size: 44px;
                                        icon-color: Theme.text-muted;
                                    }
                                }
                                Text {
                                    text: root.search-query == "" ? "Search Navidrome Library" : "No results found for '" + root.search-query + "'";
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.search-query == "" ? "Enter an artist, album title, or song name above to search." : "Try searching with a different term.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 6: GENRES (Desktop Split View vs Mobile Single-Column)
                // =============================================================
                // Desktop: Master-Detail Split View
                if root.active-view == "genres" && !root.is-mobile : HorizontalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        width: 220px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            ScrollView {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 2px;
                                    alignment: start;
                                    for g in root.genres : Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.selected-genre-name == g.name ? Theme.accent
                                                  : (g-touch.has-hover ? Theme.bg-hover : transparent);
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: g.name;
                                                color: root.selected-genre-name == g.name ? #ffffff : Theme.text-primary;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: g.song_count;
                                                color: root.selected-genre-name == g.name ? #ffffffcc : Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        g-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.select-genre(g.name); }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 1px;
                                background: Theme.border-subtle;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;

                        if root.is-loading : TrackTableSkeleton {
                            pulse: root.pulse-phase;
                            compact: false;
                        }

                        if !root.is-loading : TrackTableHeader {
                            compact: false;
                        }

                        if !root.is-loading : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for s[idx] in root.songs : TrackRow {
                                    song: s;
                                    row-index: idx;
                                    compact: false;
                                    play-song(id) => { root.play-song(id); }
                                    queue-song(id) => { root.queue-song(id); }
                                    toggle-star(id, st) => { root.toggle-star(id, st); }
                                    download-song(id) => { root.download-song(id); }
                                    open-artist(aid) => { root.open-artist(aid); }
                                    open-album(alid) => { root.open-album(alid); }
                                }
                            }
                        }
                    }
                }

                // Mobile: Full-width Genres List (Zero sidebar!)
                if root.active-view == "genres" && root.is-mobile && root.selected-genre-name == "" : VerticalLayout {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 12px;
                        spacing: 2px;
                        Text {
                            text: "Genres";
                            color: Theme.text-primary;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.genres.length + " Genres in Library";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                    }

                    Hairline {}

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;

                            for g in root.genres : Rectangle {
                                height: 50px;
                                background: gm-touch.has-hover ? Theme.bg-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 8px;
                                        background: Theme.bg-elevated;
                                        VectorIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            commands: Icons.grid;
                                            icon-size: 16px;
                                            icon-color: Theme.text-secondary;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: g.name;
                                            color: Theme.text-primary;
                                            font-size: 15px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: g.song_count + " songs";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }
                                    }

                                    VectorIcon {
                                        commands: Icons.chevron-right;
                                        icon-size: 16px;
                                        icon-color: Theme.text-muted;
                                    }
                                }

                                gm-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-genre(g.name); }
                                }

                                Hairline {
                                    y: parent.height - 1px;
                                    x: 62px;
                                    width: parent.width - 62px;
                                }
                            }
                        }
                    }
                }

                // Mobile: Full-width Genre Detail (with Back button)
                if root.active-view == "genres" && root.is-mobile && root.selected-genre-name != "" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 44px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 30px;
                                    border-radius: 15px;
                                    background: g-back.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 12px;
                                        spacing: 4px;
                                        alignment: center;
                                        VectorIcon {
                                            commands: Icons.chevron-left;
                                            icon-size: 16px;
                                            icon-color: Theme.accent;
                                        }
                                        Text {
                                            text: "Genres";
                                            color: Theme.accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    g-back := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-genre-name = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Hairline {}

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 6px;
                        Text {
                            text: root.selected-genre-name;
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                        }
                    }

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: true;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: true;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: true;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 7: DOWNLOADED / OFFLINE MUSIC
                // =============================================================
                if root.active-view == "downloads" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 48px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;

                            Text {
                                text: root.downloads-summary-text;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: root.config-auto-download-streamed ? Icons.check : Icons.download;
                                    label: root.config-auto-download-streamed ? "Auto-Download on Stream: ON" : "Auto-Download on Stream: OFF";
                                    active: root.config-auto-download-streamed;
                                    clicked => {
                                        root.config-auto-download-streamed = !root.config-auto-download-streamed;
                                        root.toggle-auto-download-streamed(root.config-auto-download-streamed);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    label: "Clear Offline Cache";
                                    clicked => { root.clear-downloads(); }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.downloaded-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 8: PLAYLISTS
                // =============================================================
                if root.active-view == "playlists" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 54px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.selected-playlist-name != "" ? root.selected-playlist-name : "Select or Create a Playlist";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.selected-playlist-count + " songs · " + root.selected-playlist-duration;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                StyledTextInput {
                                    width: 170px;
                                    height: 28px;
                                    placeholder: "New playlist name...";
                                    text <=> root.new-playlist-name;
                                    accepted(val) => { root.create-new-playlist(val); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.plus;
                                    label: "Create";
                                    primary: true;
                                    clicked => { root.create-new-playlist(root.new-playlist-name); }
                                }
                            }

                            if root.selected-playlist-id != "" && root.now-playing-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.plus;
                                    label: "Add Playing Song";
                                    clicked => { root.add-current-song-to-playlist(root.selected-playlist-id); }
                                }
                            }

                            if root.selected-playlist-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.download;
                                    label: "Download";
                                    clicked => { root.download-selected-playlist(); }
                                }
                            }

                            if root.selected-playlist-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.close;
                                    label: "Delete";
                                    clicked => { root.delete-selected-playlist(); }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.playlist-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                allow-remove: true;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                                remove-from-playlist(ridx) => { root.remove-song-from-selected-playlist(ridx); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 9: SETTINGS (Responsive Card-Based Layout)
                // =============================================================
                if root.active-view == "settings" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: root.is-mobile ? 14px : 24px;
                        spacing: 18px;
                        alignment: start;

                        // Section 1: Server Connection
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "NAVIDROME / OPENSUBSONIC SERVER";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Server URL";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                    StyledTextInput {
                                        text <=> root.config-server-url;
                                        placeholder: "http://localhost:4533";
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Username";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                    StyledTextInput {
                                        text <=> root.config-username;
                                        placeholder: "Username";
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Password";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                    StyledTextInput {
                                        input-type: InputType.password;
                                        text <=> root.config-password;
                                        placeholder: "Password";
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Save & Reconnect";
                                        primary: true;
                                        clicked => { root.save-and-connect(); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Quick Scan";
                                        clicked => { root.trigger-server-scan(false); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Full Rescan";
                                        clicked => { root.trigger-server-scan(true); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Sign Out";
                                        clicked => {
                                            root.offline-mode-active = false;
                                            root.disconnect-server();
                                        }
                                    }
                                }

                                Text {
                                    text: "Server Status: " + root.server-version-badge + " · Tracks: " + root.scan-count + " · Last scan: " + root.scan-last-time;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Section 2: Display & Layout Mode
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "DISPLAY & LAYOUT MODE";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Ultrasonic automatically switches between Desktop and Mobile layout depending on screen aspect ratio. You can also force a specific mode below.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Auto (Aspect Ratio)";
                                        active: root.layout-override == "auto";
                                        clicked => { root.set-layout-override("auto"); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Always Mobile";
                                        active: root.layout-override == "mobile";
                                        clicked => { root.set-layout-override("mobile"); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        label: "Always Desktop";
                                        active: root.layout-override == "desktop";
                                        clicked => { root.set-layout-override("desktop"); }
                                    }
                                }
                            }
                        }

                        // Section 3: Customizable Navigation Tabs / Sections
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "CUSTOMIZE NAVIGATION SECTIONS";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Toggle which library sections and tabs appear in the navigation bar and sidebar.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-listen-now ? Icons.check : "";
                                        label: "Listen Now";
                                        active: root.nav-show-listen-now;
                                        clicked => { root.toggle-nav-section("listen_now", !root.nav-show-listen-now); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-search ? Icons.check : "";
                                        label: "Search";
                                        active: root.nav-show-search;
                                        clicked => { root.toggle-nav-section("search", !root.nav-show-search); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-albums ? Icons.check : "";
                                        label: "Albums";
                                        active: root.nav-show-albums;
                                        clicked => { root.toggle-nav-section("albums", !root.nav-show-albums); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-artists ? Icons.check : "";
                                        label: "Artists";
                                        active: root.nav-show-artists;
                                        clicked => { root.toggle-nav-section("artists", !root.nav-show-artists); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-songs ? Icons.check : "";
                                        label: "Songs";
                                        active: root.nav-show-songs;
                                        clicked => { root.toggle-nav-section("songs", !root.nav-show-songs); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-playlists ? Icons.check : "";
                                        label: "Playlists";
                                        active: root.nav-show-playlists;
                                        clicked => { root.toggle-nav-section("playlists", !root.nav-show-playlists); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-genres ? Icons.check : "";
                                        label: "Genres";
                                        active: root.nav-show-genres;
                                        clicked => { root.toggle-nav-section("genres", !root.nav-show-genres); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: root.nav-show-favorites ? Icons.check : "";
                                        label: "Favorites";
                                        active: root.nav-show-favorites;
                                        clicked => { root.toggle-nav-section("favorites", !root.nav-show-favorites); }
                                    }
                                }
                            }
                        }

                        // Section 4: Local Storage & Offline Cache
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "LOCAL STORAGE & OFFLINE CACHE";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Ultrasonic saves album artwork and offline music tracks locally on your device for rapid browsing and offline listening.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: Icons.close;
                                        label: "Clear Cache & Local Storage";
                                        clicked => { root.clear-local-storage(); }
                                    }
                                    PillButton {
                                        h-stretch: 1;
                                        icon-path: Icons.download;
                                        label: "Clear Downloaded Tracks";
                                        clicked => { root.clear-downloads(); }
                                    }
                                }
                            }
                        }

                        // Section 5: Visible Libraries
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: "VISIBLE LIBRARIES";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    PillButton {
                                        label: "Select All";
                                        clicked => { root.select-all-libraries(); }
                                    }
                                }

                                Text {
                                    text: "Filter which music folders appear across Ultrasonic.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    for lib in root.libraries : PillButton {
                                        h-stretch: 1;
                                        icon-path: lib.selected ? Icons.check : "";
                                        label: lib.name + " (#" + lib.id + ")";
                                        active: lib.selected;
                                        clicked => { root.toggle-library(lib.id); }
                                    }
                                }
                            }
                        }

                        // Section 6: Streaming Quality & Transcoding
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "STREAMING QUALITY & TRANSCODING";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Stream Format";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for fmt in [
                                        { id: "raw", label: "Original (raw)" },
                                        { id: "flac", label: "FLAC" },
                                        { id: "opus", label: "Opus" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: fmt.label;
                                        active: root.config-stream-format == fmt.id;
                                        clicked => { root.set-stream-format(fmt.id); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for fmt in [
                                        { id: "mp3", label: "MP3" },
                                        { id: "aac", label: "AAC" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: fmt.label;
                                        active: root.config-stream-format == fmt.id;
                                        clicked => { root.set-stream-format(fmt.id); }
                                    }
                                }

                                Text {
                                    text: "Stream Max Bitrate";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for br in [
                                        { val: 0, label: "Unlimited" },
                                        { val: 320, label: "320 kbps" },
                                        { val: 256, label: "256 kbps" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: br.label;
                                        active: root.config-stream-bitrate == br.val;
                                        clicked => { root.set-stream-bitrate(br.val); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for br in [
                                        { val: 192, label: "192 kbps" },
                                        { val: 128, label: "128 kbps" },
                                        { val: 96, label: "96 kbps" },
                                        { val: 64, label: "64 kbps" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: br.label;
                                        active: root.config-stream-bitrate == br.val;
                                        clicked => { root.set-stream-bitrate(br.val); }
                                    }
                                }
                            }
                        }

                        // Section 7: Download Quality & Auto-Download
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "DOWNLOAD QUALITY & OFFLINE SYNC";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Download Format";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for fmt in [
                                        { id: "raw", label: "Original (raw)" },
                                        { id: "flac", label: "FLAC" },
                                        { id: "opus", label: "Opus" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: fmt.label;
                                        active: root.config-download-format == fmt.id;
                                        clicked => { root.set-download-format(fmt.id); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for fmt in [
                                        { id: "mp3", label: "MP3" },
                                        { id: "aac", label: "AAC" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: fmt.label;
                                        active: root.config-download-format == fmt.id;
                                        clicked => { root.set-download-format(fmt.id); }
                                    }
                                }

                                Text {
                                    text: "Download Max Bitrate";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for br in [
                                        { val: 0, label: "Unlimited" },
                                        { val: 320, label: "320 kbps" },
                                        { val: 256, label: "256 kbps" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: br.label;
                                        active: root.config-download-bitrate == br.val;
                                        clicked => { root.set-download-bitrate(br.val); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    for br in [
                                        { val: 192, label: "192 kbps" },
                                        { val: 128, label: "128 kbps" },
                                        { val: 96, label: "96 kbps" },
                                        { val: 64, label: "64 kbps" },
                                    ] : PillButton {
                                        h-stretch: 1;
                                        label: br.label;
                                        active: root.config-download-bitrate == br.val;
                                        clicked => { root.set-download-bitrate(br.val); }
                                    }
                                }

                                PillButton {
                                    h-stretch: 1;
                                    icon-path: root.config-auto-download-streamed ? Icons.check : "";
                                    label: root.config-auto-download-streamed
                                        ? "Auto-download streamed tracks for offline listening (Enabled)"
                                        : "Auto-download streamed tracks for offline listening (Disabled)";
                                    active: root.config-auto-download-streamed;
                                    clicked => {
                                        root.config-auto-download-streamed = !root.config-auto-download-streamed;
                                        root.toggle-auto-download-streamed(root.config-auto-download-streamed);
                                    }
                                }
                            }
                        }

                        // Section 8: WebUI & Shares
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "WEBUI & NAVIDROME SHARES";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Built-in WebUI active at http://localhost:" + root.config-webui-port;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                for sh in root.shares : HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    Text {
                                        text: sh.description + " — " + sh.url + " (" + sh.visit_count + " visits)";
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    PillButton {
                                        icon-path: Icons.close;
                                        label: "Delete";
                                        clicked => { root.delete-share(sh.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // SPOTIFY-STYLE DESKTOP RIGHT PANEL (Cover, Synchronized Lyrics, Up Next Queue)
            // -----------------------------------------------------------------
            if root.desktop-panel-open && !root.is-mobile : Rectangle {
                width: 320px;
                background: Theme.bg-sidebar;

                HorizontalLayout {
                    Rectangle {
                        width: 1px;
                        background: Theme.border-subtle;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding: 14px;
                        spacing: 12px;

                        // Panel Header: Tab switcher + Maximize + Close
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;

                            PillButton {
                                label: "Now Playing";
                                active: root.expanded-player-tab == "cover";
                                clicked => { root.expanded-player-tab = "cover"; }
                            }
                            PillButton {
                                label: "Lyrics";
                                active: root.expanded-player-tab == "lyrics";
                                clicked => { root.expanded-player-tab = "lyrics"; }
                            }
                            PillButton {
                                label: "Queue";
                                active: root.expanded-player-tab == "queue";
                                clicked => { root.expanded-player-tab = "queue"; }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            IconButton {
                                btn-size: 26px;
                                icon-size: 13px;
                                icon-path: Icons.expand;
                                clicked => {
                                    root.expanded-player-open = true;
                                    root.desktop-panel-open = false;
                                }
                            }
                            IconButton {
                                btn-size: 26px;
                                icon-size: 13px;
                                icon-path: Icons.close;
                                clicked => { root.desktop-panel-open = false; }
                            }
                        }

                        Hairline {}

                        // Tab 1: Cover / Track info
                        if root.expanded-player-tab == "cover" : VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            Rectangle {
                                width: 290px;
                                height: 290px;
                                border-radius: 8px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                if root.now-playing-has-cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.now-playing-cover;
                                    image-fit: cover;
                                }
                                if !root.now-playing-has-cover : VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.note;
                                    icon-size: 64px;
                                    icon-color: Theme.text-muted;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: root.now-playing-title;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.now-playing-artist;
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                if root.now-playing-album != "" : Text {
                                    text: root.now-playing-album;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 20px;
                                    border-radius: 4px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.now-playing-quality;
                                            color: Theme.text-secondary;
                                            font-size: 10px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.now-playing-is-local : Rectangle {
                                    width: 46px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: #30d15824;
                                    Text {
                                        text: "LOCAL";
                                        color: Theme.green-badge;
                                        font-size: 9px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                if root.now-playing-id != "" : IconButton {
                                    btn-size: 26px;
                                    icon-size: 14px;
                                    icon-path: root.now-playing-starred ? Icons.heart-fill : Icons.heart-line;
                                    active: root.now-playing-starred;
                                    clicked => { root.toggle-star(root.now-playing-id, !root.now-playing-starred); }
                                }
                            }
                        }

                        // Tab 2: Lyrics
                        if root.expanded-player-tab == "lyrics" : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-top: 8px;
                                alignment: start;

                                for line in root.lyrics-lines : Text {
                                    text: line.text;
                                    color: line.active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: line.active ? 16px : 13px;
                                    font-weight: line.active ? 700 : 500;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Tab 3: Queue
                        if root.expanded-player-tab == "queue" : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 4px;
                                PillButton {
                                    h-stretch: 1;
                                    label: "Save";
                                    clicked => { root.save-queue-to-server(); }
                                }
                                PillButton {
                                    h-stretch: 1;
                                    label: "Load";
                                    clicked => { root.load-queue-from-server(); }
                                }
                                PillButton {
                                    h-stretch: 1;
                                    label: "Clear";
                                    clicked => { root.clear-queue(); }
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    for qs in root.queue-songs : Rectangle {
                                        height: 40px;
                                        border-radius: 5px;
                                        background: qs.is_playing ? Theme.bg-selected : (q-item-touch.has-hover ? Theme.bg-hover : transparent);

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: qs.title;
                                                    color: qs.is_playing ? Theme.accent : Theme.text-primary;
                                                    font-size: 12px;
                                                    font-weight: qs.is_playing ? 600 : 400;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: qs.artist;
                                                    color: Theme.text-secondary;
                                                    font-size: 11px;
                                                    overflow: elide;
                                                }
                                            }

                                            Text {
                                                text: qs.duration_text;
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        q-item-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.play-song(qs.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // DESKTOP TRANSPORT BAR
        // =====================================================================
        if !root.is-mobile : Rectangle {
            height: 76px;
            background: Theme.bg-transport;

            VerticalLayout {
                Hairline {}

                HorizontalLayout {
                    vertical-stretch: 1;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 20px;

                    // Left: Artwork + Track Metadata + Favorite (Clicking toggles desktop side panel)
                    HorizontalLayout {
                        width: 320px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 6px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                if root.now-playing-has-cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.now-playing-cover;
                                    image-fit: cover;
                                }
                                if !root.now-playing-has-cover : VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.note;
                                    icon-size: 20px;
                                    icon-color: Theme.text-muted;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.desktop-panel-open = !root.desktop-panel-open;
                                        root.expanded-player-tab = "cover";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.now-playing-title;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if root.now-playing-is-local : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 42px;
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #30d15824;
                                        Text {
                                            text: "LOCAL";
                                            color: Theme.green-badge;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.now-playing-artist + (root.now-playing-album != "" ? " — " + root.now-playing-album : "");
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.desktop-panel-open = !root.desktop-panel-open;
                                    root.expanded-player-tab = "cover";
                                }
                            }
                        }

                        if root.now-playing-id != "" : VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 28px;
                                icon-size: 15px;
                                icon-path: root.now-playing-starred ? Icons.heart-fill : Icons.heart-line;
                                active: root.now-playing-starred;
                                clicked => { root.toggle-star(root.now-playing-id, !root.now-playing-starred); }
                            }
                        }
                    }

                    // Center: Transport Controls + Scrubber Bar
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            IconButton {
                                btn-size: 28px;
                                icon-size: 14px;
                                icon-path: Icons.shuffle;
                                active: root.shuffle-enabled;
                                clicked => { root.toggle-shuffle(); }
                            }
                            IconButton {
                                btn-size: 30px;
                                icon-size: 15px;
                                icon-path: Icons.prev;
                                clicked => { root.transport-prev(); }
                            }
                            IconButton {
                                btn-size: 34px;
                                icon-size: 16px;
                                icon-path: root.is-playing ? Icons.pause : Icons.play;
                                primary: true;
                                clicked => { root.transport-play-pause(); }
                            }
                            IconButton {
                                btn-size: 30px;
                                icon-size: 15px;
                                icon-path: Icons.next;
                                clicked => { root.transport-next(); }
                            }
                            IconButton {
                                btn-size: 28px;
                                icon-size: 14px;
                                icon-path: Icons.repeat;
                                active: root.repeat-mode != "off";
                                clicked => { root.cycle-repeat(); }
                            }
                        }

                        HorizontalLayout {
                            height: 20px;
                            spacing: 10px;
                            Text {
                                width: 38px;
                                text: root.playback-current-time;
                                color: Theme.text-muted;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            TrackSlider {
                                horizontal-stretch: 1;
                                value <=> root.playback-progress;
                                changed(val) => { root.transport-seek(val); }
                            }
                            Text {
                                width: 38px;
                                text: root.playback-total-time;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Right: Quality Badge + Star Rating + Volume + Lyrics/Queue/Maximize Toggles
                    HorizontalLayout {
                        width: 360px;
                        spacing: 10px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 22px;
                                width: 90px;
                                border-radius: 4px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                Text {
                                    text: root.now-playing-quality;
                                    color: Theme.text-secondary;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        if root.now-playing-id != "" : VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 3px;
                                for star-val in [1, 2, 3, 4, 5] : Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    VectorIcon {
                                        commands: Icons.star;
                                        icon-size: 12px;
                                        icon-color: root.now-playing-rating >= star-val ? Theme.accent : Theme.text-muted;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-song-rating(root.now-playing-id, star-val); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            VectorIcon {
                                commands: Icons.volume;
                                icon-size: 15px;
                                icon-color: Theme.text-secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            TrackSlider {
                                width: 72px;
                                fill-color: Theme.text-primary;
                                value <=> root.volume;
                                changed(val) => { root.transport-volume(val); }
                            }
                        }

                        // Right panel toggles & Fullscreen Maximize button
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                IconButton {
                                    btn-size: 28px;
                                    icon-size: 14px;
                                    icon-path: Icons.lyrics;
                                    active: root.desktop-panel-open && root.expanded-player-tab == "lyrics";
                                    clicked => {
                                        if root.desktop-panel-open && root.expanded-player-tab == "lyrics" {
                                            root.desktop-panel-open = false;
                                        } else {
                                            root.desktop-panel-open = true;
                                            root.expanded-player-tab = "lyrics";
                                        }
                                    }
                                }
                                IconButton {
                                    btn-size: 28px;
                                    icon-size: 14px;
                                    icon-path: Icons.queue;
                                    active: root.desktop-panel-open && root.expanded-player-tab == "queue";
                                    clicked => {
                                        if root.desktop-panel-open && root.expanded-player-tab == "queue" {
                                            root.desktop-panel-open = false;
                                        } else {
                                            root.desktop-panel-open = true;
                                            root.expanded-player-tab = "queue";
                                        }
                                    }
                                }
                                IconButton {
                                    btn-size: 28px;
                                    icon-size: 14px;
                                    icon-path: Icons.expand;
                                    clicked => {
                                        root.expanded-player-open = true;
                                        root.desktop-panel-open = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // MOBILE MINI-PLAYER + BOTTOM TAB BAR
        // =====================================================================
        if root.is-mobile : VerticalLayout {
            // Mobile Mini-Player (Tap opens fullscreen Expanded Player)
            Rectangle {
                height: 56px;
                background: Theme.bg-elevated;

                VerticalLayout {
                    Hairline {}
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        // Clickable artwork & info container
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 5px;
                                    background: Theme.bg-sidebar;
                                    clip: true;
                                    if root.now-playing-has-cover : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.now-playing-cover;
                                        image-fit: cover;
                                    }
                                    if !root.now-playing-has-cover : VectorIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.note;
                                        icon-size: 16px;
                                        icon-color: Theme.text-muted;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: root.now-playing-title;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.now-playing-artist + " · " + root.now-playing-quality;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.expanded-player-open = true; }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 32px;
                                icon-size: 15px;
                                icon-path: root.is-playing ? Icons.pause : Icons.play;
                                primary: true;
                                clicked => { root.transport-play-pause(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 32px;
                                icon-size: 15px;
                                icon-path: Icons.next;
                                clicked => { root.transport-next(); }
                            }
                        }
                    }
                }
            }

            // Mobile Bottom Navigation Bar (No dedicated offline tab; includes Search; dynamic visibility)
            Rectangle {
                height: 54px;
                background: Theme.bg-transport;

                VerticalLayout {
                    Hairline {}
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 6px;
                        padding-right: 6px;

                        if root.nav-show-listen-now : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.listen-now;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "listen_now" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Listen Now";
                                    color: root.active-view == "listen_now" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "listen_now" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate("listen_now"); }
                            }
                        }

                        if root.nav-show-search : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.search;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "search" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Search";
                                    color: root.active-view == "search" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "search" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate("search"); }
                            }
                        }

                        if root.nav-show-albums : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.album;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "albums" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Albums";
                                    color: root.active-view == "albums" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "albums" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate("albums"); }
                            }
                        }

                        if root.nav-show-artists : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.artist;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "artists" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Artists";
                                    color: root.active-view == "artists" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "artists" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-artist-id = "";
                                    root.navigate("artists");
                                }
                            }
                        }

                        if root.nav-show-songs : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.note;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "songs" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Songs";
                                    color: root.active-view == "songs" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "songs" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate("songs"); }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: Icons.settings;
                                        icon-size: 15px;
                                        icon-color: root.active-view == "settings" ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: "Settings";
                                    color: root.active-view == "settings" ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == "settings" ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate("settings"); }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // FULLSCREEN EXPANDED PLAYER OVERLAY (Mobile Fullscreen + Desktop Maximized)
    // =========================================================================
    if root.expanded-player-open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg-canvas;

        VerticalLayout {
            // Top Navigation Bar
            Rectangle {
                height: 56px;
                background: Theme.bg-sidebar;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            btn-size: 36px;
                            icon-size: 18px;
                            icon-path: Icons.chevron-down;
                            clicked => { root.expanded-player-open = false; }
                        }
                    }

                    // Mode Switcher Pills
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;

                        PillButton {
                            label: "Song";
                            active: root.expanded-player-tab == "cover";
                            clicked => { root.expanded-player-tab = "cover"; }
                        }
                        PillButton {
                            label: "Lyrics";
                            active: root.expanded-player-tab == "lyrics";
                            clicked => { root.expanded-player-tab = "lyrics"; }
                        }
                        PillButton {
                            label: "Queue";
                            active: root.expanded-player-tab == "queue";
                            clicked => { root.expanded-player-tab = "queue"; }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        if root.now-playing-id != "" : IconButton {
                            btn-size: 36px;
                            icon-size: 18px;
                            icon-path: root.now-playing-starred ? Icons.heart-fill : Icons.heart-line;
                            active: root.now-playing-starred;
                            clicked => { root.toggle-star(root.now-playing-id, !root.now-playing-starred); }
                        }
                    }
                }
            }

            Hairline {}

            // Body Area: Cover & Controls
            if root.expanded-player-tab == "cover" : VerticalLayout {
                vertical-stretch: 1;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 16px;
                padding-bottom: 20px;
                alignment: center;
                spacing: 16px;

                // Center Album Artwork
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: Math.min(300px, root.width - 64px);
                        height: self.width;
                        border-radius: 12px;
                        background: Theme.bg-elevated;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;

                        if root.now-playing-has-cover : Image {
                            width: 100%;
                            height: 100%;
                            source: root.now-playing-cover;
                            image-fit: cover;
                        }
                        if !root.now-playing-has-cover : VectorIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: Icons.note;
                            icon-size: 72px;
                            icon-color: Theme.text-muted;
                        }
                    }
                }

                // Track Title & Artist
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.now-playing-title;
                            color: Theme.text-primary;
                            font-size: 20px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        if root.now-playing-is-local : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 18px;
                                border-radius: 4px;
                                background: #30d15824;
                                Text {
                                    text: "LOCAL";
                                    color: Theme.green-badge;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.now-playing-artist + (root.now-playing-album != "" ? " — " + root.now-playing-album : "");
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: root.now-playing-quality;
                        color: Theme.text-muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }

                // Scrubber Bar
                VerticalLayout {
                    spacing: 4px;
                    TrackSlider {
                        value <=> root.playback-progress;
                        changed(val) => { root.transport-seek(val); }
                    }
                    HorizontalLayout {
                        Text {
                            text: root.playback-current-time;
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.playback-total-time;
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                    }
                }

                // Big Transport Controls
                HorizontalLayout {
                    alignment: center;
                    spacing: 24px;

                    IconButton {
                        btn-size: 40px;
                        icon-size: 18px;
                        icon-path: Icons.shuffle;
                        active: root.shuffle-enabled;
                        clicked => { root.toggle-shuffle(); }
                    }
                    IconButton {
                        btn-size: 44px;
                        icon-size: 20px;
                        icon-path: Icons.prev;
                        clicked => { root.transport-prev(); }
                    }
                    IconButton {
                        btn-size: 56px;
                        icon-size: 26px;
                        icon-path: root.is-playing ? Icons.pause : Icons.play;
                        primary: true;
                        clicked => { root.transport-play-pause(); }
                    }
                    IconButton {
                        btn-size: 44px;
                        icon-size: 20px;
                        icon-path: Icons.next;
                        clicked => { root.transport-next(); }
                    }
                    IconButton {
                        btn-size: 40px;
                        icon-size: 18px;
                        icon-path: Icons.repeat;
                        active: root.repeat-mode != "off";
                        clicked => { root.cycle-repeat(); }
                    }
                }

                // Volume Slider Row
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    width: Math.min(280px, root.width - 64px);

                    VectorIcon {
                        commands: Icons.volume;
                        icon-size: 16px;
                        icon-color: Theme.text-secondary;
                    }
                    TrackSlider {
                        horizontal-stretch: 1;
                        fill-color: Theme.text-primary;
                        value <=> root.volume;
                        changed(val) => { root.transport-volume(val); }
                    }
                }
            }

            // Body Area: Lyrics
            if root.expanded-player-tab == "lyrics" : VerticalLayout {
                vertical-stretch: 1;
                padding: 20px;

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 16px;
                        alignment: center;
                        for line in root.lyrics-lines : Text {
                            text: line.text;
                            color: line.active ? Theme.text-primary : Theme.text-secondary;
                            font-size: line.active ? 20px : 15px;
                            font-weight: line.active ? 700 : 500;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Mini Scrubber & Transport for lyrics mode
                VerticalLayout {
                    spacing: 8px;
                    TrackSlider {
                        value <=> root.playback-progress;
                        changed(val) => { root.transport-seek(val); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;
                        IconButton {
                            btn-size: 34px;
                            icon-size: 16px;
                            icon-path: Icons.prev;
                            clicked => { root.transport-prev(); }
                        }
                        IconButton {
                            btn-size: 42px;
                            icon-size: 20px;
                            icon-path: root.is-playing ? Icons.pause : Icons.play;
                            primary: true;
                            clicked => { root.transport-play-pause(); }
                        }
                        IconButton {
                            btn-size: 34px;
                            icon-size: 16px;
                            icon-path: Icons.next;
                            clicked => { root.transport-next(); }
                        }
                    }
                }
            }

            // Body Area: Queue
            if root.expanded-player-tab == "queue" : VerticalLayout {
                vertical-stretch: 1;
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    PillButton {
                        h-stretch: 1;
                        label: "Save Queue";
                        clicked => { root.save-queue-to-server(); }
                    }
                    PillButton {
                        h-stretch: 1;
                        label: "Load Queue";
                        clicked => { root.load-queue-from-server(); }
                    }
                    PillButton {
                        h-stretch: 1;
                        label: "Clear";
                        clicked => { root.clear-queue(); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for qs in root.queue-songs : Rectangle {
                            height: 48px;
                            border-radius: 6px;
                            background: qs.is_playing ? Theme.bg-selected : (exp-q-touch.has-hover ? Theme.bg-hover : transparent);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: qs.title;
                                        color: qs.is_playing ? Theme.accent : Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: qs.is_playing ? 700 : 400;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: qs.artist;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: qs.duration_text;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            exp-q-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.play-song(qs.id); }
                            }
                        }
                    }
                }

                // Mini Scrubber & Transport for queue mode
                VerticalLayout {
                    spacing: 8px;
                    TrackSlider {
                        value <=> root.playback-progress;
                        changed(val) => { root.transport-seek(val); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;
                        IconButton {
                            btn-size: 34px;
                            icon-size: 16px;
                            icon-path: Icons.prev;
                            clicked => { root.transport-prev(); }
                        }
                        IconButton {
                            btn-size: 42px;
                            icon-size: 20px;
                            icon-path: root.is-playing ? Icons.pause : Icons.play;
                            primary: true;
                            clicked => { root.transport-play-pause(); }
                        }
                        IconButton {
                            btn-size: 34px;
                            icon-size: 16px;
                            icon-path: Icons.next;
                            clicked => { root.transport-next(); }
                        }
                    }
                }
            }
        }
    }
}
