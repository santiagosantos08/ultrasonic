component TrackTableSkeleton inherits VerticalLayout {
    in property <bool> pulse: false;
    in property <bool> compact: false;
    spacing: 0px;

    TrackTableHeader {
        compact: root.compact;
    }

    for i in [0, 1, 2, 3, 4, 5, 6, 7] : TrackRowSkeleton {
        pulse: root.pulse;
        compact: root.compact;
        row-index: i;
    }
}

