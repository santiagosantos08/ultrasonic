import { ScrollView } from "std-widgets.slint";

export struct LibraryItem {
    id: string,
    name: string,
    selected: bool,
}

export struct AlbumItem {
    id: string,
    title: string,
    artist: string,
    artist_id: string,
    year: string,
    genre: string,
    song_count: int,
    duration_text: string,
    starred: bool,
    cover: image,
    has_cover: bool,
}

export struct ArtistItem {
    id: string,
    name: string,
    album_count: int,
    starred: bool,
}

export struct SongItem {
    id: string,
    track_num: string,
    title: string,
    artist: string,
    artist_id: string,
    album: string,
    album_id: string,
    duration_text: string,
    duration_secs: int,
    quality_badge: string,
    starred: bool,
    rating: int,
    is_downloaded: bool,
    is_playing: bool,
    play_count: int,
    disc_number: int,
}

export struct PlaylistItem {
    id: string,
    name: string,
    comment: string,
    owner: string,
    public: bool,
    song_count: int,
    duration_text: string,
}

export struct GenreItem {
    name: string,
    song_count: int,
    album_count: int,
}

export struct LyricLineItem {
    time_ms: int,
    text: string,
    active: bool,
}

export struct ShareItem {
    id: string,
    url: string,
    description: string,
    visit_count: int,
}

global Theme {
    out property <color> bg-canvas: #101012;
    out property <color> bg-sidebar: #161619;
    out property <color> bg-elevated: #1d1d21;
    out property <color> bg-input: #18181c;
    out property <color> bg-transport: #17171a;
    out property <color> bg-row-alt: #131316;
    out property <color> bg-hover: #222227;
    out property <color> bg-selected: #28161b;
    out property <color> border-subtle: #26262b;
    out property <color> accent: #fa2d48;
    out property <color> accent-hover: #ff455d;
    out property <color> accent-soft: #fa2d4826;
    out property <color> green-badge: #30d158;
    out property <color> text-primary: #f5f5f7;
    out property <color> text-secondary: #98989f;
    out property <color> text-muted: #636369;
}

