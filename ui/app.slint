                            }
                        }
                    }

                    Hairline {}

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 6px;
                        Text {
                            text: root.selected-genre-name;
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                        }
                    }

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: true;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: true;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: true;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 7: DOWNLOADED / OFFLINE MUSIC
                // =============================================================
                if root.active-view == "downloads" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 48px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;

                            Text {
                                text: root.downloads-summary-text;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: root.config-auto-download-streamed ? Icons.check : Icons.download;
                                    label: root.config-auto-download-streamed ? "Auto-Download on Stream: ON" : "Auto-Download on Stream: OFF";
                                    active: root.config-auto-download-streamed;
                                    clicked => {
                                        root.config-auto-download-streamed = !root.config-auto-download-streamed;
                                        root.toggle-auto-download-streamed(root.config-auto-download-streamed);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    label: "Clear Offline Cache";
                                    clicked => { root.clear-downloads(); }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.downloaded-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 8: PLAYLISTS
                // =============================================================
                if root.active-view == "playlists" : VerticalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        height: 54px;
                        background: Theme.bg-sidebar;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.selected-playlist-name != "" ? root.selected-playlist-name : "Select or Create a Playlist";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.selected-playlist-count + " songs · " + root.selected-playlist-duration;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                StyledTextInput {
                                    width: 170px;
                                    height: 28px;
                                    placeholder: "New playlist name...";
                                    text <=> root.new-playlist-name;
                                    accepted(val) => { root.create-new-playlist(val); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.plus;
                                    label: "Create";
                                    primary: true;
                                    clicked => { root.create-new-playlist(root.new-playlist-name); }
                                }
                            }

                            if root.selected-playlist-id != "" && root.now-playing-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.plus;
                                    label: "Add Playing Song";
                                    clicked => { root.add-current-song-to-playlist(root.selected-playlist-id); }
                                }
                            }

                            if root.selected-playlist-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.download;
                                    label: "Download";
                                    clicked => { root.download-selected-playlist(); }
                                }
                            }

                            if root.selected-playlist-id != "" : VerticalLayout {
                                alignment: center;
                                PillButton {
                                    icon-path: Icons.close;
                                    label: "Delete";
                                    clicked => { root.delete-selected-playlist(); }
                                }
                            }
                        }
                    }

                    Hairline {}

                    if root.is-loading : TrackTableSkeleton {
                        pulse: root.pulse-phase;
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : TrackTableHeader {
                        compact: root.is-mobile;
                    }

                    if !root.is-loading : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for s[idx] in root.playlist-songs : TrackRow {
                                song: s;
                                row-index: idx;
                                compact: root.is-mobile;
                                allow-remove: true;
                                play-song(id) => { root.play-song(id); }
                                queue-song(id) => { root.queue-song(id); }
                                toggle-star(id, st) => { root.toggle-star(id, st); }
                                download-song(id) => { root.download-song(id); }
                                open-artist(aid) => { root.open-artist(aid); }
                                open-album(alid) => { root.open-album(alid); }
                                remove-from-playlist(ridx) => { root.remove-song-from-selected-playlist(ridx); }
                            }
                        }
                    }
                }

                // =============================================================
                // VIEW 9: SETTINGS
                // =============================================================
                if root.active-view == "settings" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 22px;
                        alignment: start;

                        // Section 1: Navidrome Server Connection
                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "NAVIDROME / OPENSUBSONIC SERVER";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 140px;
                                    text: "Server URL";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                StyledTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.config-server-url;
                                    placeholder: "http://localhost:4533";
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 140px;
                                    text: "Username";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                StyledTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.config-username;
                                    placeholder: "Username";
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 140px;
                                    text: "Password";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                StyledTextInput {
                                    horizontal-stretch: 1;
                                    input-type: InputType.password;
                                    text <=> root.config-password;
                                    placeholder: "Password";
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                PillButton {
                                    label: "Save & Reconnect";
                                    primary: true;
                                    clicked => { root.save-and-connect(); }
                                }
                                PillButton {
                                    label: "Quick Scan";
                                    clicked => { root.trigger-server-scan(false); }
                                }
                                PillButton {
                                    label: "Full Rescan";
                                    clicked => { root.trigger-server-scan(true); }
                                }
                                PillButton {
                                    label: "Sign Out";
                                    clicked => {
                                        root.offline-mode-active = false;
                                        root.disconnect-server();
                                    }
                                }
                            }
                            Text {
                                text: "Server Status: " + root.server-version-badge + " · Indexed tracks: " + root.scan-count + " · Last scan: " + root.scan-last-time;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }

                        Hairline {}

                        // Section 2: Multi-Library Selection
                        VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: "VISIBLE LIBRARIES (MULTI-LIBRARY SELECTION)";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: "Select All Libraries";
                                        clicked => { root.select-all-libraries(); }
                                    }
                                }
                            }
                            Text {
                                text: "Select one or multiple Navidrome libraries (`musicFolderId`) to include across browsing and search.";
                                color: Theme.text-secondary;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for lib in root.libraries : PillButton {
                                    icon-path: lib.selected ? Icons.check : "";
                                    label: lib.name + " (#" + lib.id + ")";
                                    active: lib.selected;
                                    clicked => { root.toggle-library(lib.id); }
                                }
                            }
                        }

                        Hairline {}

                        // Section 3: Configurable Streaming Rate & Format
                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "STREAMING QUALITY & TRANSCODING (`stream` endpoint)";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    width: 140px;
                                    text: "Stream Format";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                for fmt in [
                                    { id: "raw", label: "Original (raw)" },
                                    { id: "flac", label: "FLAC" },
                                    { id: "opus", label: "Opus" },
                                    { id: "mp3", label: "MP3" },
                                    { id: "aac", label: "AAC" },
                                ] : VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: fmt.label;
                                        active: root.config-stream-format == fmt.id;
                                        clicked => { root.set-stream-format(fmt.id); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    width: 140px;
                                    text: "Max Bitrate";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                for br in [
                                    { val: 0, label: "Unlimited" },
                                    { val: 320, label: "320 kbps" },
                                    { val: 256, label: "256 kbps" },
                                    { val: 192, label: "192 kbps" },
                                    { val: 128, label: "128 kbps" },
                                    { val: 96, label: "96 kbps" },
                                    { val: 64, label: "64 kbps" },
                                ] : VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: br.label;
                                        active: root.config-stream-bitrate == br.val;
                                        clicked => { root.set-stream-bitrate(br.val); }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        // Section 4: Configurable Download Rate, Format & Auto-Download Toggle
                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "DOWNLOAD QUALITY & AUTO-DOWNLOAD (`download` endpoint)";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    width: 140px;
                                    text: "Download Format";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                for fmt in [
                                    { id: "raw", label: "Original (raw)" },
                                    { id: "flac", label: "FLAC" },
                                    { id: "opus", label: "Opus" },
                                    { id: "mp3", label: "MP3" },
                                    { id: "aac", label: "AAC" },
                                ] : VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: fmt.label;
                                        active: root.config-download-format == fmt.id;
                                        clicked => { root.set-download-format(fmt.id); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    width: 140px;
                                    text: "Download Bitrate";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                for br in [
                                    { val: 0, label: "Unlimited" },
                                    { val: 320, label: "320 kbps" },
                                    { val: 256, label: "256 kbps" },
                                    { val: 192, label: "192 kbps" },
                                    { val: 128, label: "128 kbps" },
                                    { val: 96, label: "96 kbps" },
                                    { val: 64, label: "64 kbps" },
                                ] : VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: br.label;
                                        active: root.config-download-bitrate == br.val;
                                        clicked => { root.set-download-bitrate(br.val); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 12px;
                                alignment: start;
                                Text {
                                    width: 140px;
                                    text: "Auto-Download";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        icon-path: root.config-auto-download-streamed ? Icons.check : "";
                                        label: root.config-auto-download-streamed
                                            ? "Automatically download tracks when streamed once (Enabled)"
                                            : "Automatically download tracks when streamed once (Disabled)";
                                        active: root.config-auto-download-streamed;
                                        clicked => {
                                            root.config-auto-download-streamed = !root.config-auto-download-streamed;
                                            root.toggle-auto-download-streamed(root.config-auto-download-streamed);
                                        }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        // Section 5: Shares & WebUI Info
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "WEBUI & NAVIDROME SHARES";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: "WebUI Server active on http://localhost:" + root.config-webui-port;
                                color: Theme.text-secondary;
                                font-size: 12px;
                            }
                            for sh in root.shares : HorizontalLayout {
                                height: 30px;
                                spacing: 10px;
                                Text {
                                    text: sh.description + " — " + sh.url + " (" + sh.visit_count + " visits)";
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        icon-path: Icons.close;
                                        label: "Delete";
                                        clicked => { root.delete-share(sh.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // RIGHT INSPECTION DRAWER (Synchronized Lyrics or Up Next Queue)
            // -----------------------------------------------------------------
            if root.right-drawer != "none" && !root.is-mobile : Rectangle {
                width: 300px;
                background: Theme.bg-sidebar;

                HorizontalLayout {
                    Rectangle {
                        width: 1px;
                        background: Theme.border-subtle;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 28px;
                            Text {
                                text: root.right-drawer == "lyrics" ? "Lyrics" : "Up Next";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if root.right-drawer == "queue" : VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 4px;
                                    PillButton {
                                        label: "Save";
                                        clicked => { root.save-queue-to-server(); }
                                    }
                                    PillButton {
                                        label: "Load";
                                        clicked => { root.load-queue-from-server(); }
                                    }
                                    PillButton {
                                        label: "Clear";
                                        clicked => { root.clear-queue(); }
                                    }
                                }
                            }
                        }

                        Hairline {}

                        if root.right-drawer == "lyrics" : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-top: 8px;
                                alignment: start;

                                for line in root.lyrics-lines : Text {
                                    text: line.text;
                                    color: line.active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: line.active ? 16px : 13px;
                                    font-weight: line.active ? 700 : 500;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.right-drawer == "queue" : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                for qs in root.queue-songs : Rectangle {
                                    height: 40px;
                                    border-radius: 5px;
                                    background: qs.is_playing ? Theme.bg-selected : (q-item-touch.has-hover ? Theme.bg-hover : transparent);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: qs.title;
                                                color: qs.is_playing ? Theme.accent : Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: qs.is_playing ? 600 : 400;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: qs.artist;
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            text: qs.duration_text;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    q-item-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.play-song(qs.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // DESKTOP TRANSPORT BAR
        // =====================================================================
        if !root.is-mobile : Rectangle {
            height: 76px;
            background: Theme.bg-transport;

            VerticalLayout {
                Hairline {}

                HorizontalLayout {
                    vertical-stretch: 1;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 20px;

                    // Left: Artwork + Track Metadata + Favorite
                    HorizontalLayout {
                        width: 320px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 6px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                if root.now-playing-has-cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.now-playing-cover;
                                    image-fit: cover;
                                }
                                if !root.now-playing-has-cover : VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.note;
                                    icon-size: 20px;
                                    icon-color: Theme.text-muted;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.now-playing-album-id != "") {
                                            root.open-album(root.now-playing-album-id);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.now-playing-title;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if root.now-playing-is-local : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 42px;
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #30d15824;
                                        Text {
                                            text: "LOCAL";
                                            color: Theme.green-badge;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.now-playing-artist + (root.now-playing-album != "" ? " — " + root.now-playing-album : "");
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        if root.now-playing-id != "" : VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 28px;
                                icon-size: 15px;
                                icon-path: root.now-playing-starred ? Icons.heart-fill : Icons.heart-line;
                                active: root.now-playing-starred;
                                clicked => { root.toggle-star(root.now-playing-id, !root.now-playing-starred); }
                            }
                        }
                    }

                    // Center: Transport Controls + Scrubber Bar
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            IconButton {
                                btn-size: 28px;
                                icon-size: 14px;
                                icon-path: Icons.shuffle;
                                active: root.shuffle-enabled;
                                clicked => { root.toggle-shuffle(); }
                            }
                            IconButton {
                                btn-size: 30px;
                                icon-size: 15px;
                                icon-path: Icons.prev;
                                clicked => { root.transport-prev(); }
                            }
                            IconButton {
                                btn-size: 34px;
                                icon-size: 16px;
                                icon-path: root.is-playing ? Icons.pause : Icons.play;
                                primary: true;
                                clicked => { root.transport-play-pause(); }
                            }
                            IconButton {
                                btn-size: 30px;
                                icon-size: 15px;
                                icon-path: Icons.next;
                                clicked => { root.transport-next(); }
                            }
                            IconButton {
                                btn-size: 28px;
                                icon-size: 14px;
                                icon-path: Icons.repeat;
                                active: root.repeat-mode != "off";
                                clicked => { root.cycle-repeat(); }
                            }
                        }

                        HorizontalLayout {
                            height: 20px;
                            spacing: 10px;
                            Text {
                                width: 38px;
                                text: root.playback-current-time;
                                color: Theme.text-muted;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            TrackSlider {
                                horizontal-stretch: 1;
                                value <=> root.playback-progress;
                                changed(val) => { root.transport-seek(val); }
                            }
                            Text {
                                width: 38px;
                                text: root.playback-total-time;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Right: Stream/Lossless Quality Badge + Star Rating + Volume
                    HorizontalLayout {
                        width: 310px;
                        spacing: 12px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 22px;
                                width: 106px;
                                border-radius: 4px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                Text {
                                    text: root.now-playing-quality;
                                    color: Theme.text-secondary;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        if root.now-playing-id != "" : VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 3px;
                                for star-val in [1, 2, 3, 4, 5] : Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    VectorIcon {
                                        commands: Icons.star;
                                        icon-size: 12px;
                                        icon-color: root.now-playing-rating >= star-val ? Theme.accent : Theme.text-muted;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-song-rating(root.now-playing-id, star-val); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            VectorIcon {
                                commands: Icons.volume;
                                icon-size: 15px;
                                icon-color: Theme.text-secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            TrackSlider {
                                width: 84px;
                                fill-color: Theme.text-primary;
                                value <=> root.volume;
                                changed(val) => { root.transport-volume(val); }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // MOBILE MINI-PLAYER + BOTTOM TAB BAR
        // =====================================================================
        if root.is-mobile : VerticalLayout {
            Rectangle {
                height: 56px;
                background: Theme.bg-elevated;

                VerticalLayout {
                    Hairline {}
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 38px;
                                height: 38px;
                                border-radius: 5px;
                                background: Theme.bg-sidebar;
                                clip: true;
                                if root.now-playing-has-cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.now-playing-cover;
                                    image-fit: cover;
                                }
                                if !root.now-playing-has-cover : VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.note;
                                    icon-size: 16px;
                                    icon-color: Theme.text-muted;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.now-playing-title;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: root.now-playing-artist + " · " + root.now-playing-quality;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 32px;
                                icon-size: 15px;
                                icon-path: root.is-playing ? Icons.pause : Icons.play;
                                primary: true;
                                clicked => { root.transport-play-pause(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                btn-size: 32px;
                                icon-size: 15px;
                                icon-path: Icons.next;
                                clicked => { root.transport-next(); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 54px;
                background: Theme.bg-transport;

                VerticalLayout {
                    Hairline {}
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: 6px;
                        padding-right: 6px;

                        for tab in [
                            { id: "listen_now", icon: Icons.listen-now, title: "Listen Now" },
                            { id: "albums", icon: Icons.album, title: "Albums" },
                            { id: "artists", icon: Icons.artist, title: "Artists" },
                            { id: "songs", icon: Icons.note, title: "Songs" },
                            { id: "downloads", icon: Icons.download, title: "Offline" },
                            { id: "settings", icon: Icons.settings, title: "Settings" },
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: center;
                                    VectorIcon {
                                        commands: tab.icon;
                                        icon-size: 15px;
                                        icon-color: root.active-view == tab.id ? Theme.accent : Theme.text-secondary;
                                    }
                                }
                                Text {
                                    text: tab.title;
                                    color: root.active-view == tab.id ? Theme.accent : Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: root.active-view == tab.id ? 600 : 400;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if tab.id == "artists" {
                                        root.selected-artist-id = "";
                                    }
                                    if tab.id == "genres" {
                                        root.selected-genre-name = "";
                                    }
                                    root.navigate(tab.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
