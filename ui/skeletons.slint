import { Theme, Hairline } from "theme.slint";
import { TrackTableHeader } from "components.slint";

export component SkeletonBlock inherits Rectangle {
    in property <length> radius: 4px;
    in property <bool> pulse: false;
    border-radius: root.radius;
    background: #18181d;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: parent.border-radius;
        background: #282833;
        opacity: root.pulse ? 0.75 : 0.22;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
}

export component TrackRowSkeleton inherits Rectangle {
    in property <bool> pulse: false;
    in property <bool> compact: false;
    in property <int> row-index: 0;

    height: 38px;
    background: Math.mod(root.row-index, 2) == 1 ? Theme.bg-row-alt : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            width: 32px;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                SkeletonBlock {
                    width: 16px;
                    height: 10px;
                    radius: 3px;
                    pulse: root.pulse;
                }
            }
        }

        VerticalLayout {
            width: 24px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                SkeletonBlock {
                    width: 14px;
                    height: 14px;
                    radius: 7px;
                    pulse: root.pulse;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 3;
            alignment: center;
            spacing: 4px;
            SkeletonBlock {
                width: 65%;
                height: 12px;
                radius: 3px;
                pulse: root.pulse;
            }
            if root.compact : SkeletonBlock {
                width: 40%;
                height: 10px;
                radius: 3px;
                pulse: root.pulse;
            }
        }

        if !root.compact : VerticalLayout {
            horizontal-stretch: 2;
            alignment: center;
            SkeletonBlock {
                width: 50%;
                height: 11px;
                radius: 3px;
                pulse: root.pulse;
            }
        }

        if !root.compact : VerticalLayout {
            horizontal-stretch: 2;
            alignment: center;
            SkeletonBlock {
                width: 45%;
                height: 11px;
                radius: 3px;
                pulse: root.pulse;
            }
        }

        if !root.compact : VerticalLayout {
            width: 96px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                SkeletonBlock {
                    width: 44px;
                    height: 14px;
                    radius: 3px;
                    pulse: root.pulse;
                }
            }
        }

        VerticalLayout {
            width: 52px;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                SkeletonBlock {
                    width: 30px;
                    height: 10px;
                    radius: 3px;
                    pulse: root.pulse;
                }
            }
        }

        VerticalLayout {
            width: 76px;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                SkeletonBlock {
                    width: 20px;
                    height: 20px;
                    radius: 10px;
                    pulse: root.pulse;
                }
                SkeletonBlock {
                    width: 20px;
                    height: 20px;
                    radius: 10px;
                    pulse: root.pulse;
                }
            }
        }
    }
}

export component AlbumTileSkeleton inherits Rectangle {
    in property <bool> pulse: false;
    width: 156px;
    height: 204px;
    background: transparent;

    VerticalLayout {
        spacing: 7px;

        SkeletonBlock {
            width: 156px;
            height: 156px;
            radius: 6px;
            pulse: root.pulse;
        }

        SkeletonBlock {
            width: 115px;
            height: 12px;
            radius: 3px;
            pulse: root.pulse;
        }

        SkeletonBlock {
            width: 75px;
            height: 10px;
            radius: 3px;
            pulse: root.pulse;
        }
    }
}

export component AlbumRowSkeleton inherits Rectangle {
    in property <bool> pulse: false;
    in property <int> row-index: 0;
    height: 64px;
    border-radius: 6px;
    background: Math.mod(root.row-index, 2) == 1 ? Theme.bg-row-alt : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        alignment: center;

        SkeletonBlock {
            width: 46px;
            height: 46px;
            radius: 4px;
            pulse: root.pulse;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            SkeletonBlock {
                width: 40%;
                height: 13px;
                radius: 3px;
                pulse: root.pulse;
            }

            SkeletonBlock {
                width: 24%;
                height: 11px;
                radius: 3px;
                pulse: root.pulse;
            }
        }

        VerticalLayout {
            width: 80px;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                SkeletonBlock {
                    width: 50px;
                    height: 11px;
                    radius: 3px;
                    pulse: root.pulse;
                }
            }
        }
    }
}

export component TrackTableSkeleton inherits VerticalLayout {
    in property <bool> pulse: false;
    in property <bool> compact: false;
    spacing: 0px;

    TrackTableHeader {
        compact: root.compact;
    }

    for i in [0, 1, 2, 3, 4, 5, 6, 7] : TrackRowSkeleton {
        pulse: root.pulse;
        compact: root.compact;
        row-index: i;
    }
}

export component AlbumDetailSkeleton inherits VerticalLayout {
    in property <bool> pulse: false;
    in property <bool> compact: false;
    spacing: 18px;
    padding: 22px;

    HorizontalLayout {
        spacing: 22px;

        SkeletonBlock {
            width: 168px;
            height: 168px;
            radius: 8px;
            pulse: root.pulse;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 10px;

            SkeletonBlock {
                width: 55%;
                height: 22px;
                radius: 4px;
                pulse: root.pulse;
            }

            SkeletonBlock {
                width: 35%;
                height: 16px;
                radius: 4px;
                pulse: root.pulse;
            }

            SkeletonBlock {
                width: 25%;
                height: 12px;
                radius: 3px;
                pulse: root.pulse;
            }

            HorizontalLayout {
                spacing: 8px;
                SkeletonBlock {
                    width: 80px;
                    height: 28px;
                    radius: 6px;
                    pulse: root.pulse;
                }
                SkeletonBlock {
                    width: 80px;
                    height: 28px;
                    radius: 6px;
                    pulse: root.pulse;
                }
            }
        }
    }

    Hairline {}

    TrackTableSkeleton {
        pulse: root.pulse;
        compact: root.compact;
    }
}

export component ArtistDetailSkeleton inherits VerticalLayout {
    in property <bool> pulse: false;
    in property <bool> compact: false;
    spacing: 16px;
    padding: 20px;

    HorizontalLayout {
        spacing: 18px;

        SkeletonBlock {
            width: 90px;
            height: 90px;
            radius: 45px;
            pulse: root.pulse;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;

            SkeletonBlock {
                width: 45%;
                height: 22px;
                radius: 4px;
                pulse: root.pulse;
            }

            SkeletonBlock {
                width: 70%;
                height: 12px;
                radius: 3px;
                pulse: root.pulse;
            }

            SkeletonBlock {
                width: 50%;
                height: 12px;
                radius: 3px;
                pulse: root.pulse;
            }
        }
    }

    Hairline {}

    Text {
        text: "Top Songs";
        color: Theme.text-primary;
        font-size: 14px;
        font-weight: 700;
    }

    for i in [0, 1, 2, 3, 4] : TrackRowSkeleton {
        pulse: root.pulse;
        compact: root.compact;
        row-index: i;
    }
}
